\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Static panel across three rounds (140 tasks; temperature 0.7, top-$p$ 0.8, top-$k$ 20, fixed seed). ``Target'' counts selections matching the frozen original label; $\Delta $ is the paired net change against Direct within the same run; $p$ and the exact 95\% CI come from two-sided exact McNemar tests on wrong--target discordant pairs \citep  {mcnemar1947note}, which exclude abstentions and interface failures, retained in $\Delta $'s denominator. Original and replication rounds ran on the 27B model (8.86M and 8.84M tokens, 2{,}230 replication requests), transfer on an 8B model (8.14M). Error composition and the development subset are in Appendix\nobreakspace  {}\ref {app:details}.\relax }}{8}{table.caption.2}\protected@file@percent }
\newlabel{tab:static-main}{{1}{8}{Static panel across three rounds (140 tasks; temperature 0.7, top-$p$ 0.8, top-$k$ 20, fixed seed). ``Target'' counts selections matching the frozen original label; $\Delta $ is the paired net change against Direct within the same run; $p$ and the exact 95\% CI come from two-sided exact McNemar tests on wrong--target discordant pairs \citep {mcnemar1947note}, which exclude abstentions and interface failures, retained in $\Delta $'s denominator. Original and replication rounds ran on the 27B model (8.86M and 8.84M tokens, 2{,}230 replication requests), transfer on an 8B model (8.14M). Error composition and the development subset are in Appendix~\ref {app:details}.\relax }{table.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Matched-configuration replication (Appendix\nobreakspace  {}\ref {app:details}): three request seeds for Direct and \textsc  {Cers}{}, SC3 majority over the Direct seeds at no extra requests, the bounded tabular-answering baseline (two requests per task; 55 abstentions and 18 transcription failures in the denominator), and the clean-chart control. $\Delta $ and $p$ are paired against the Direct seed-12345 run; accuracy is the full-denominator fraction matching the frozen original label.\relax }}{8}{table.caption.3}\protected@file@percent }
\newlabel{tab:static-seed}{{2}{8}{Matched-configuration replication (Appendix~\ref {app:details}): three request seeds for Direct and \ours {}, SC3 majority over the Direct seeds at no extra requests, the bounded tabular-answering baseline (two requests per task; 55 abstentions and 18 transcription failures in the denominator), and the clean-chart control. $\Delta $ and $p$ are paired against the Direct seed-12345 run; accuracy is the full-denominator fraction matching the frozen original label.\relax }{table.caption.3}{}}
